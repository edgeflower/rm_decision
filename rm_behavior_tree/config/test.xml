<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4"
      main_tree_to_execute="BehaviorTree">
  <BehaviorTree ID="BehaviorTree">
    <Sequence name="NavigateAndVerify">
      <SubRobotPosture topic_name="sentry_posture_status"
                       posture_status="{posture_status}"
                       posture="{current_posture}"/>
      <Sequence name="NavigateAndVerify">
        <SetPosture posture="1"
                    override="False"
                    current_posture="{current_posture}"/>
        <Wait duration="3.0"/>
      </Sequence>
      <Sequence name="NavigateAndVerify">
        <SetPosture posture="2"
                    override="False"
                    current_posture="{current_posture}"/>
        <Wait duration="3.0"/>
      </Sequence>
      <Sequence name="NavigateAndVerify">
        <SetPosture posture="3"
                    override="False"
                    current_posture="{current_posture}"/>
        <Wait duration="3.0"/>
      </Sequence>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="SetPosture"
            editable="true">
      <input_port name="posture"
                  default="{robot_posture_status}"/>
      <input_port name="override"
                  default="False"/>
      <input_port name="current_posture"
                  default="{current_posture}"/>
    </Action>
    <Action ID="SubRobotPosture"
            editable="true">
      <input_port name="topic_name"
                  default="robot_posture_status"/>
      <output_port name="posture_status"
                   default="{posture_status}"/>
      <output_port name="posture"
                     default="{current_posture}"/>
    </Action>
    <Action ID="Wait">
      <input_port name="duration"
                  default="1.0"/>
    </Action>
  </TreeNodesModel>

</root>
