<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="attack_robot">
    <ReactiveSequence>
      <RobotControl stop_gimbal_scan="True"
                    chassis_spin_vel="0.0"
                    gimbal_big_yaw_vel="40.0"/>
      <GetLocation name="GetRobotPose"
                   topic_name="odometry"
                   robot_location="{robot_pose}"/>
      <SubArmors topic_name="target_tracking"
                 armors="{armors}"/>
      <WhileDoElse name="Evade when attacked">
        <IsDetectEnemy message="{armors}"/>
        <AsyncSequence>
          <EnemyPositionFilter enemy_position="{armors}"
                               alpha="0.3"
                               max_distance="10.0"
                               history_size="5"
                               zero_threshold="0.1"
                               filtered_position="{filtered_position}"/>
          <RobotControl stop_gimbal_scan="True"
                        chassis_spin_vel="0.5"
                        gimbal_big_yaw_vel="0.0"/>
          <ArmorToGoal armor_message="{filtered_position}"/>
        </AsyncSequence>
        <Sequence name="NavigateAndVerify">
          <RobotControl stop_gimbal_scan="True"
                        chassis_spin_vel="0.0"
                        gimbal_big_yaw_vel="40.0"/>
          <GoalManager robot_pose="{robot_pose}"
                       lethal_threshold="252"
                       high_cost_threshold="200"
                       visit_timeout="30.0"
                       max_retries="2"
                       reset_requested="{reset_requested}"
                       best_goal="{best_goal}"
                       selected_id="{goal_id}"
                       should_reset="{should_reset}"
                       idle_count="{idle_count}"
                       done_count="{done_count}"/>
          <Sequence name="NavigateAndVerify">
            <SendGoal name="NavigateToObservation"
                      goal_pose="{best_goal}"
                      action_name="/navigate_to_pose"/>
            <RetryUntilSuccessful num_attempts="3">
              <IsGoalReached name="VerifyGoalReached"
                             goal_id="{goal_id}"
                             check_current="true"
                             current_goal_id="{goal_id}"/>
            </RetryUntilSuccessful>
          </Sequence>
        </Sequence>
      </WhileDoElse>
    </ReactiveSequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="ArmorToGoal"
            editable="true">
      <input_port name="armor_message"
                  default="{armor_message}"/>
    </Action>
    <Action ID="EnemyPositionFilter"
            editable="true">
      <input_port name="enemy_position"
                  default="{armors}"/>
      <input_port name="alpha"
                  default="0.3"/>
      <input_port name="max_distance"
                  default="10.0"/>
      <input_port name="history_size"
                  default="5"/>
      <input_port name="zero_threshold"
                  default="0.1"/>
      <output_port name="filtered_position"
                   default="{filtered_position}"/>
    </Action>
    <Action ID="GetLocation"
            editable="true">
      <input_port name="topic_name"
                  default="/red_standard_robot1/lidar_odometry"/>
      <output_port name="robot_location"
                   default="{current_location}"/>
    </Action>
    <Action ID="GoalManager">
      <input_port name="robot_pose"
                  default="{robot_pose}"/>
      <input_port name="lethal_threshold"
                  default="252"/>
      <input_port name="high_cost_threshold"
                  default="200"/>
      <input_port name="visit_timeout"
                  default="30.0"/>
      <input_port name="max_retries"
                  default="2"/>
      <input_port name="reset_requested"
                  default="false"/>
      <output_port name="best_goal"
                   default="{best_goal}"/>
      <output_port name="selected_id"
                   default="{goal_id}"/>
      <output_port name="should_reset"
                   default="{should_reset}"/>
      <output_port name="idle_count"
                   default="{idle_count}"/>
      <output_port name="done_count"
                   default="{done_count}"/>
    </Action>
    <Action ID="IsDetectEnemy"
            editable="true">
      <input_port name="message"
                  default="{armors}"/>
    </Action>
    <Condition ID="IsGoalReached">
      <input_port name="goal_id"
                  default="0"/>
      <input_port name="check_current"
                  default="false"/>
      <input_port name="current_goal_id"
                  default="0"/>
    </Condition>
    <Action ID="RobotControl"
            editable="true">
      <input_port name="stop_gimbal_scan"
                  default="True"/>
      <input_port name="chassis_spin_vel"
                  default="False"/>
      <input_port name="gimbal_big_yaw_vel"
                  default="1.0"/>
    </Action>
    <Action ID="SendGoal">
      <input_port name="goal_pose"
                  default="0;0;0; 0;0;0;1"/>
      <input_port name="action_name"
                  default="/navigate_to_pose"/>
    </Action>
    <Action ID="SubArmors"
            editable="true">
      <input_port name="topic_name"
                  default="/detector/armors"/>
      <output_port name="armors"
                   default="{armors}"/>
    </Action>
  </TreeNodesModel>

</root>
