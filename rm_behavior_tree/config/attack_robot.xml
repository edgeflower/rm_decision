<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4"
      main_tree_to_execute="attack_robot">
  <BehaviorTree ID="PatrolObservationPoints">
    <Sequence name="PatrolSequence">
      <RobotControl stop_gimbal_scan="True"
                    chassis_spin_vel="0.0"
                    gimbal_big_yaw_vel="40.0"/>
      <SendMyGoal name="NavigateToObservation"
                  my_goal_pose="7.70342;6.30384;0;0;0;-0.530557;0.847649"
                  action_name="/navigate_to_pose"/>
      <SendMyGoal name="NavigateToObservation"
                  my_goal_pose="0.831862;6.28261;0;0;0;-0.406026;0.913861"
                  action_name="/navigate_to_pose"/>
      <SendMyGoal name="NavigateToObservation"
                  my_goal_pose="2.93173;4.10752;0;0;0;-0.598128;0.801401"
                  action_name="/navigate_to_pose"/>
      <SendMyGoal name="NavigateToObservation"
                  my_goal_pose="7.55072;2.4705;0;0;0;-0.620193;0.78445"
                  action_name="/navigate_to_pose"/>
      <SendMyGoal name="NavigateToObservation"
                  my_goal_pose="-0.335534;0.580256;0;0;0;-0.568031;0.823007"
                  action_name="/navigate_to_pose"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="attack_robot">
    <Sequence>
      <ReactiveSequence name="DataAcquisition">
        <SubArmors topic_name="/target_tracking"
                   armors="{armors}"/>
        <EnemyPositionFilter enemy_position="{armors}"
                             alpha="0.2"
                             max_distance="1.0"
                             history_size="7"
                             zero_threshold="0.1"
                             min_output_interval="0.1"
                             filtered_position="{filtered_target}"/>
      </ReactiveSequence>
      <WhileDoElse>
        <EnemyPositionFilter enemy_position="{armors}"
                             alpha="0.2"
                             max_distance="1.0"
                             history_size="7"
                             zero_threshold="0.1"
                             min_output_interval="0.1"
                             filtered_position="{filtered_target}"/>
        <Sequence>
          <ConfidenceHysteresis target="{filtered_target}"
                                upper_threshold="0.5"
                                lower_threshold="0.2"
                                grace_period="2.5"
                                enable_hold_position="true"
                                current_confidence="{current_confidence}"
                                hysteresis_state="{hysteresis_state}"/>
          <ReactiveFallback name="GimbalControl">
            <Sequence>
              <CheckHysteresisState state="{hysteresis_state}"
                                    expected_state="HIGH"/>
              <RobotControl stop_gimbal_scan="True"
                            chassis_spin_vel="0.0"
                            gimbal_big_yaw_vel="0.0"/>
            </Sequence>
            <Sequence>
              <CheckHysteresisState state="{hysteresis_state}"
                                    expected_state="GRACE_PERIOD"/>
              <RobotControl stop_gimbal_scan="True"
                            chassis_spin_vel="0.0"
                            gimbal_big_yaw_vel="0.0"/>
            </Sequence>
            <RobotControl stop_gimbal_scan="True"
                          chassis_spin_vel="0.0"
                          gimbal_big_yaw_vel="40.0"/>
          </ReactiveFallback>
          <ReactiveFallback name="NavigationDecision">
            <ReactiveSequence>
              <CheckHysteresisState state="{hysteresis_state}"
                                    expected_state="HIGH"/>
              <ArmorToGoal target_message="{filtered_target}"
                           goal_pose="{goal}"/>
              <SendGoal name="ChaseEnemy"
                        goal_pose="{goal}"
                        action_name="/navigate_to_pose"
                        min_goal_distance="0.5"
                        current_goal_id="-2"
                        reached_goal_id="{attack_reached_goal_id}"/>
            </ReactiveSequence>
            <ReactiveSequence>
              <CheckHysteresisState state="{hysteresis_state}"
                                    expected_state="GRACE_PERIOD"/>
              <HoldPosition target="{filtered_target}"
                            enabled="true"
                            robot_pose="{robot_pose}"
                            held_goal="{goal}"
                            is_holding="{is_holding}"/>
              <SendGoal name="HoldCurrentPosition"
                        goal_pose="{goal}"
                        action_name="/navigate_to_pose"
                        min_goal_distance="0.5"
                        current_goal_id="-2"
                        reached_goal_id="{hold_reached_goal_id}"/>
            </ReactiveSequence>
            <ReactiveSequence>
              <CheckHysteresisState state="{hysteresis_state}"
                                    expected_state="LOW"/>
              <AbortNavigation action_name="/navigate_to_pose"/>
              <SubTree ID="PatrolObservationPoints"
                       goal_pose=""/>
            </ReactiveSequence>
          </ReactiveFallback>
        </Sequence>
        <Sequence>
          <AbortNavigation action_name="/navigate_to_pose"/>
          <SubTree ID="PatrolObservationPoints"
                   goal_pose=""
                   _autoremap="false"/>
        </Sequence>
      </WhileDoElse>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="AbortNavigation">
      <input_port name="action_name"
                  default="/navigate_to_pose"/>
    </Action>
    <Action ID="ArmorToGoal">
      <input_port name="target_message"
                  default="{target_message}"/>
      <output_port name="goal_pose"
                   default="{goal}"/>
    </Action>
    <Condition ID="CheckHysteresisState">
      <input_port name="state"
                  default="{hysteresis_state}"/>
      <input_port name="expected_state"
                  default="HIGH"/>
    </Condition>
    <Condition ID="ConfidenceHysteresis">
      <input_port name="target"
                  default="{filtered_target}"/>
      <input_port name="upper_threshold"
                  default="0.4"/>
      <input_port name="lower_threshold"
                  default="0.3"/>
      <input_port name="grace_period"
                  default="1.5"/>
      <input_port name="enable_hold_position"
                  default="true"/>
      <output_port name="current_confidence"
                   default="{current_confidence}"/>
      <output_port name="hysteresis_state"
                   default="{hysteresis_state}"/>
    </Condition>
    <Action ID="EnemyPositionFilter"
            editable="true">
      <input_port name="enemy_position"
                  default="{armors}"/>
      <input_port name="alpha"
                  default="0.3"/>
      <input_port name="max_distance"
                  default="1.5"/>
      <input_port name="history_size"
                  default="5"/>
      <input_port name="zero_threshold"
                  default="0.1"/>
      <input_port name="min_output_interval"
                  default="0.1"/>
      <output_port name="filtered_position"
                   default="{filtered_position}"/>
    </Action>
    <Action ID="HoldPosition">
      <input_port name="target"
                  default="{filtered_target}"/>
      <input_port name="enabled"
                  default="true"/>
      <input_port name="robot_pose"
                  default="{robot_pose}"/>
      <output_port name="held_goal"
                   default="{goal}"/>
      <output_port name="is_holding"
                   default="{is_holding}"/>
    </Action>
    <SubTree ID="PatrolObservationPoints">
      <input_port name="goal_pose"/>
    </SubTree>
    <Action ID="RobotControl">
      <input_port name="stop_gimbal_scan"
                  default="True"/>
      <input_port name="chassis_spin_vel"
                  default="0.0"/>
      <input_port name="gimbal_big_yaw_vel"
                  default="1.0"/>
    </Action>
    <Action ID="SendGoal">
      <input_port name="goal_pose"
                  default="{best_goal}"/>
      <input_port name="action_name"
                  default="/navigate_to_pose"/>
      <input_port name="min_goal_distance"
                  default="0.5"/>
      <input_port name="current_goal_id"
                  default="{goal_id}"/>
      <output_port name="reached_goal_id"
                   default="{reached_goal_id}"/>
    </Action>
    <Action ID="SendMyGoal">
      <input_port name="my_goal_pose"
                  default="{best_goal}"/>
      <input_port name="action_name"
                  default="/navigate_to_pose"/>
    </Action>
    <Action ID="SubArmors"
            editable="true">
      <input_port name="topic_name"
                  default="/detector/armors"/>
      <output_port name="armors"
                   default="{armors}"/>
    </Action>
  </TreeNodesModel>

</root>
